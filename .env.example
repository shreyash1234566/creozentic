# Creozentic environment template
# Copy to .env.local for local development. Never commit real secrets.
NODE_ENV=development
APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_BACKEND_ENABLED=false
NEXT_PUBLIC_WORKSPACE_ID=workspace-autozentic-demo
NEXT_PUBLIC_USER_ID=user-autozentic-owner
DEMO_WORKSPACE_ID=workspace-autozentic-demo
DEMO_USER_ID=user-autozentic-owner
LOG_LEVEL=info
RELEASE_VERSION=local
CREOZENTIC_RELEASE_MODE=development

# Database and queues
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/creozentic?schema=public
REDIS_URL=redis://127.0.0.1:6379
BULLMQ_TEST_PREFIX=creozentic-local

# Authentication and encryption
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_COOKIE=creozentic_session
CONNECTION_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
ENTERPRISE_SSO_VALIDATE_URL=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CONNECTOR_OAUTH_CALLBACK_URL=http://127.0.0.1:3000/api/v1/connections

# Object storage: local by default; use R2/S3 values for production
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_ROOT=.data/storage
LOCAL_STORAGE_SIGNING_SECRET=replace-with-local-signing-secret
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Media binaries
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_FONT_PATH=
PG_DUMP_PATH=pg_dump

# AI and creative providers
LOCAL_CREATIVE_PROVIDER_ENABLED=true
LOCAL_TEXT_PROVIDER_ENABLED=true
CREATIVE_PROVIDER_ID=local
CREATIVE_PROVIDER_URL=
CREATIVE_PROVIDER_API_KEY=
CREATIVE_PROVIDER_ENDPOINTS={}
CREATIVE_PROVIDER_TIMEOUT_MS=30000
TEXT_PROVIDER_URL=
TEXT_PROVIDER_API_KEY=
TEXT_PROVIDER_TIMEOUT_MS=30000
MEDIA_RENDERER_URL=
MEDIA_RENDERER_API_KEY=
MEDIA_ANALYSIS_PROVIDER_URL=
INTELLIGENCE_PROVIDER_API_KEY=
OCR_PROVIDER_URL=
INTEGRITY_PROVIDER_URL=
MALWARE_SCAN_PROVIDER_URL=
MASKING_PROVIDER_URL=
MODERATION_PROVIDER_URL=
MODERATION_PROVIDER_API_KEY=
CUSTOM_MODEL_TRAIN_URL=
CUSTOM_MODEL_TRAIN_API_KEY=
CUSTOM_MODEL_TRAIN_STATUS_URL=
CUSTOM_MODEL_TRAIN_CANCEL_URL=
PROVIDER_HOST_ALLOWLIST=
ALLOW_INSECURE_PROVIDER_HTTP=false

# Adopted engines and workers
CORE_ENGINE_REF_ROOT=/tmp/creozentic-core-refs
AVE_ENABLED=false
OPENSHORTS_ENABLED=false
PIXELTABLE_ENABLED=false
VIMAX_ENABLED=false
VIDEOAGENT_ENABLED=false
VIDEODB_ENABLED=false
REMOTION_ENABLED=false
COMFYUI_ENABLED=false
TEMPORAL_ENABLED=false
OPENCHATCUT_ENABLED=false
OPENMONTAGE_ENABLED=false
TWICK_ENABLED=false
GPU_WORKER_ENABLED=false
RUN_WORKER=false
RUN_API=false

# Social platform applications
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v22.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_ADAPTER_URL=
TIKTOK_ADAPTER_URL=
YOUTUBE_ADAPTER_URL=
LINKEDIN_ADAPTER_URL=

# Billing
STRIPE_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LAGO_API_URL=
LAGO_API_KEY=

# Notifications, webhooks, and schedules
WEBHOOK_SIGNING_SECRET=replace-with-webhook-signing-secret
NOTIFICATION_CRON_SECRET=replace-with-notification-cron-secret
SCHEDULE_CRON_SECRET=replace-with-schedule-cron-secret
NOVU_API_URL=
NOVU_API_KEY=
SVIX_API_URL=
SVIX_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
SENTRY_DSN=
PROMETHEUS_PUSHGATEWAY_URL=
GRAFANA_URL=
GRAFANA_API_KEY=

# Smoke and integration testing
SMOKE_BASE_URL=http://127.0.0.1:3000
SMOKE_AUTH_TOKEN=
SMOKE_USER_ID=user-autozentic-owner
SMOKE_WORKSPACE_ID=workspace-autozentic-demo
INTEGRATION_BASE_URL=
LOAD_BASE_URL=http://127.0.0.1:3000
LOAD_REQUESTS=25
LOAD_CONCURRENCY=5
