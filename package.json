{
  "name": "creozentic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx src/server/worker.ts",
    "test:production-smoke": "tsx scripts/production-smoke.ts",
    "test:e2e": "playwright test",
    "test:integration": "tsx --test tests/integration/**/*.test.ts",
    "test:load": "node tests/load/health-load.mjs",
    "test:unit": "tsx --test tests/core-contracts.test.ts tests/editor-contracts.test.ts tests/guide-complete-contracts.test.ts tests/adopted-engines.test.ts tests/media-evidence.test.ts tests/package-boundaries.test.ts tests/part2-runtime.test.ts tests/security-boundaries.test.ts",
    "test": "pnpm test:unit && pnpm test:production-smoke",
    "format": "oxfmt",
    "guide:check": "tsx scripts/guide-completeness.ts",
    "oss:check": "tsx scripts/oss-completeness.ts",
    "benchmark:editor": "tsx scripts/editor-benchmark.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "env:check": "tsx scripts/validate-env.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
    "@aws-sdk/s3-request-presigner": "^3.1107.0",
    "@motion-canvas/2d": "^3.17.2",
    "@motion-canvas/core": "^3.17.2",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/swagger": "^11.4.6",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bullmq": "^6.0.11",
    "ioredis": "^6.0.0",
    "motion": "^13.1.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xlsx": "^0.18.5",
    "xstate": "^5.32.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "oxfmt": "^0.63.0",
    "prisma": "^7.9.1",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
