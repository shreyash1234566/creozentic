generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipRole {
  OWNER
  ADMIN
  STRATEGIST
  EDITOR
  REVIEWER
  CLIENT
  PUBLISHER
  BILLING
  VIEWER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum AssetType {
  ORIGINAL
  REFERENCE
  PRODUCT
  LOGO
  FONT
  GENERATED
  APPROVED
  REJECTED
  EXPORT
  PUBLISHED
}

enum AssetStatus {
  UPLOADING
  READY
  QUARANTINED
  IMMUTABLE
  DERIVED
  SOFT_DELETED
}

enum ProductLockMode {
  PRODUCT_LOCK
  CREATIVE
}

enum WorkflowVisibility {
  PRIVATE
  WORKSPACE
  PUBLIC
}

enum RunState {
  DRAFT
  QUOTED
  RESERVED
  QUEUED
  RUNNING
  AWAITING_REVIEW
  APPROVED
  SUCCEEDED
  EXPORTED
  PUBLISHED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  CANCELLED
}

enum NodeState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRYING
  CANCELLED
  AWAITING_REVIEW
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  REFINEMENT_REQUESTED
}

enum OutputStatus {
  DRAFT
  APPROVED
  REJECTED
  EXPORTED
  PUBLISHED
}

enum LedgerKind {
  RESERVE
  CONSUME
  RELEASE
  REFUND
  ADJUSTMENT
  TOPUP
  EXPIRY
}

enum ReservationStatus {
  RESERVED
  SETTLED
  RELEASED
  REFUNDED
}

enum ConnectionHealth {
  HEALTHY
  EXPIRING
  EXPIRED
  DISCONNECTED
  ERROR
}

enum BatchState {
  DRAFT
  QUEUED
  RUNNING
  PAUSED
  COMPLETED
  PARTIAL_FAILURE
  CANCELLED
}

model User {
  id                      String              @id @default(cuid())
  externalId              String?             @unique
  email                   String              @unique
  name                    String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  memberships             Membership[]
  auditEvents             AuditEvent[]
  reviewTasks             ReviewTask[]        @relation("ReviewAssignee")
  comments                Comment[]
  apiKeys                 ApiKey[]
  channelIdentities       ChannelIdentity[]
  marketplaceReviews      MarketplaceReview[]
  dailyPlansReviewed      DailyContentPlan[]  @relation("DailyPlanReviewer")
  creativeRequestsCreated CreativeRequest[]   @relation("CreativeRequestRequester")
  approvalGatesReviewed   ApprovalGate[]      @relation("ApprovalGateReviewer")
  autonomyPoliciesCreated AutonomyPolicy[]    @relation("AutonomyPolicyCreator")
}

model Workspace {
  id                         String                      @id @default(cuid())
  slug                       String                      @unique
  name                       String
  ownerId                    String
  plan                       String                      @default("starter")
  status                     WorkspaceStatus             @default(ACTIVE)
  region                     String                      @default("IN")
  retentionDays              Int                         @default(90)
  spendingCap                Int?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  memberships                Membership[]
  brands                     Brand[]
  assets                     Asset[]
  products                   Product[]
  templates                  WorkflowTemplate[]
  runs                       WorkflowRun[]
  reviews                    ReviewTask[]
  outputs                    OutputAsset[]
  connections                Connection[]
  creditAccount              CreditAccount?
  ledgerEntries              LedgerEntry[]
  providerCosts              ProviderCost[]
  auditEvents                AuditEvent[]
  consentRecords             ConsentRecord[]
  events                     OutboxEvent[]
  idempotencyKeys            IdempotencyKey[]
  brandRules                 BrandRule[]
  creditReservations         CreditReservation[]
  apiKeys                    ApiKey[]
  billingEvents              BillingEvent[]
  subscriptions              Subscription[]
  invoices                   Invoice[]
  performanceMetrics         PerformanceMetric[]
  performanceRecommendations PerformanceRecommendation[]
  reviewLinks                ReviewLink[]
  oauthStates                OAuthState[]
  batches                    BatchRun[]
  batchRows                  BatchRow[]
  exportManifests            ExportManifest[]
  localizationJobs           LocalizationJob[]
  localizationVariants       LocalizationVariant[]
  schedules                  Schedule[]
  deployedApps               DeployedApp[]
  connectorEvents            ConnectorEvent[]
  channelIdentities          ChannelIdentity[]
  channelMessages            ChannelMessage[]
  driveSyncJobs              DriveSyncJob[]
  driveFiles                 DriveFile[]
  mediaJobs                  MediaJob[]
  referencePacks             ReferencePack[]
  consistencyChecks          ConsistencyCheck[]
  policies                   WorkspacePolicy[]
  benchmarkSuites            BenchmarkSuite[]
  benchmarkCases             BenchmarkCase[]
  benchmarkRuns              BenchmarkRun[]
  benchmarkResults           BenchmarkResult[]
  marketplacePackages        MarketplacePackage[]
  marketplaceInstalls        MarketplaceInstall[]
  marketplaceReviews         MarketplaceReview[]
  competitorSources          CompetitorSource[]
  competitorInsights         CompetitorInsight[]
  whiteLabelConfig           WhiteLabelConfig?
  enterpriseControl          EnterpriseControl?
  customModelProjects        CustomModelProject[]
  customModelDatasets        CustomModelDataset[]
  customModelEvaluations     CustomModelEvaluation[]
  customModelReleases        CustomModelRelease[]
  assetScans                 AssetScan[]
  mediaAnalyses              MediaAnalysis[]
  ugcProjects                UGCProject[]
  comparisons                ModelComparison[]
  comparisonOutputs          ModelComparisonOutput[]
  ugcShots                   UGCShot[]
  trainingJobs               CustomModelTrainingJob[]
  billingRefunds             BillingRefund[]
  backupRuns                 BackupRun[]
  launchEvidence             LaunchEvidence[]
  dailyPublicationJobs       DailyPublicationJob[]
  dailyContentPlans          DailyContentPlan[]
  creativeRequests           CreativeRequest[]
  agentRuns                  AgentRun[]
  notifications              Notification[]
  deadLetterJobs             DeadLetterJob[]
  campaigns                  CampaignBrief[]
  templateDefinitions        TemplateDefinition[]
  creativePlans              CreativePlan[]
  approvalGates              ApprovalGate[]
  autonomyPolicies           AutonomyPolicy[]
  failureRecords             FailureRecord[]
  performanceObservations    PerformanceObservation[]
  calendarEntries            ContentCalendarEntry[]
  agencyWorkItems            AgencyWorkItem[]
}

model Membership {
  id           String           @id @default(cuid())
  workspaceId  String
  userId       String
  role         MembershipRole   @default(VIEWER)
  status       MembershipStatus @default(ACTIVE)
  lastAccessAt DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, status])
}

model Brand {
  id                String                 @id @default(cuid())
  workspaceId       String
  name              String
  version           Int                    @default(1)
  approvalStatus    String                 @default("DRAFT")
  approvedBy        String?
  approvedAt        DateTime?
  profile           Json
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  rules             BrandRule[]
  assets            Asset[]
  products          Product[]
  dailyContentPlans DailyContentPlan[]
  creativeRequests  CreativeRequest[]
  autonomyPolicies  AutonomyPolicy[]
  calendarEntries   ContentCalendarEntry[]
  agencyWorkItems   AgencyWorkItem[]
  outboxEvents      OutboxEvent[]
  schedules         Schedule[]
  campaigns         CampaignBrief[]
  templateDefinitions TemplateDefinition[]

  @@unique([workspaceId, name])
  @@index([workspaceId, updatedAt])
}

model BrandRule {
  id          String    @id @default(cuid())
  workspaceId String
  brandId     String
  version     Int
  type        String
  value       Json
  severity    String    @default("warning")
  source      String    @default("workspace")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([workspaceId, brandId, version])
}

model Asset {
  id                String                  @id @default(cuid())
  workspaceId       String
  brandId           String?
  productId         String?
  parentId          String?
  type              AssetType
  status            AssetStatus             @default(UPLOADING)
  name              String
  objectKey         String
  contentHash       String
  mimeType          String
  byteSize          Int?
  width             Int?
  height            Int?
  metadata          Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?
  workspace         Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand             Brand?                  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  product           Product?                @relation(fields: [productId], references: [id], onDelete: SetNull)
  parent            Asset?                  @relation("AssetLineage", fields: [parentId], references: [id], onDelete: SetNull)
  derivatives       Asset[]                 @relation("AssetLineage")
  outputs           OutputAsset[]
  driveFiles        DriveFile[]
  whiteLabelConfigs WhiteLabelConfig[]
  scans             AssetScan[]
  analyses          MediaAnalysis[]
  comparisonOutputs ModelComparisonOutput[]

  @@unique([workspaceId, contentHash])
  @@index([workspaceId, type, status])
  @@index([workspaceId, productId])
}

model Product {
  id                String          @id @default(cuid())
  workspaceId       String
  brandId           String?
  sku               String
  title             String
  description       String?
  priceMinor        Int?
  currency          String          @default("INR")
  material          String?
  dimensions        String?
  variant           String?
  lockMode          ProductLockMode @default(PRODUCT_LOCK)
  facts             Json
  claimRestrictions Json?
  sourceAssetIds    Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  deletedAt         DateTime?
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand             Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  assets            Asset[]
  referencePacks    ReferencePack[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, brandId])
}

model CampaignBrief {
  id               String    @id @default(cuid())
  workspaceId      String
  brandId          String?
  name             String
  objective        String
  offer            Json?
  productIds       Json
  audience         Json?
  legalCopy        Json?
  channels         Json
  status           String    @default("DRAFT")
  version          Int       @default(1)
  approvedBy       String?
  approvedAt       DateTime?
  evidence         Json?
  createdBy        String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@index([workspaceId, brandId, status, updatedAt])
}

model TemplateDefinition {
  id               String    @id @default(cuid())
  workspaceId      String
  brandId          String?
  name             String
  contentType      String
  version          String
  schema           Json
  lockedLayers     Json
  supportedFormats Json
  status           String    @default("DRAFT")
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand            Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, name, version])
  @@index([workspaceId, contentType, status])
}

model WorkflowTemplate {
  id                String             @id @default(cuid())
  workspaceId       String?
  ownerId           String
  name              String
  category          String
  visibility        WorkflowVisibility @default(PRIVATE)
  autopilotMetadata Json?
  publishedVersion  Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions          WorkflowVersion[]
  deployedApps      DeployedApp[]

  @@index([workspaceId, category])
}

model WorkflowVersion {
  id                  String               @id @default(cuid())
  templateId          String
  version             String
  graph               Json
  inputSchema         Json
  permissions         Json
  costFormula         Json
  immutableAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  template            WorkflowTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  runs                WorkflowRun[]
  deployedApps        DeployedApp[]
  marketplacePackages MarketplacePackage[]

  @@unique([templateId, version])
}

model WorkflowRun {
  id                String              @id @default(cuid())
  workspaceId       String
  workflowVersionId String
  deployedAppId     String?
  state             RunState            @default(DRAFT)
  title             String
  idempotencyKey    String
  briefSnapshot     Json
  brandSnapshot     Json
  productSnapshot   Json?
  quoteSnapshot     Json
  warnings          Json
  error             Json?
  reservedUnits     Int                 @default(0)
  actualUnits       Int?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workflowVersion   WorkflowVersion     @relation(fields: [workflowVersionId], references: [id])
  deployedApp       DeployedApp?        @relation(fields: [deployedAppId], references: [id], onDelete: SetNull)
  nodes             NodeRun[]
  reviewTask        ReviewTask?
  outputs           OutputAsset[]
  reservations      CreditReservation[]
  providerCosts     ProviderCost[]
  events            OutboxEvent[]
  exportManifests   ExportManifest[]
  mediaJobs         MediaJob[]
  consistencyChecks ConsistencyCheck[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, state, updatedAt])
}

model NodeRun {
  id             String      @id @default(cuid())
  runId          String
  nodeKey        String
  state          NodeState   @default(QUEUED)
  attempts       Int         @default(0)
  inputRefs      Json?
  outputRefs     Json?
  providerCallId String?
  errorClass     String?
  errorMessage   String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  run            WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nodeKey])
  @@index([runId, state])
}

model ReviewTask {
  id            String       @id @default(cuid())
  workspaceId   String
  runId         String       @unique
  assigneeId    String?
  status        ReviewStatus @default(PENDING)
  kind          String       @default("static")
  title         String
  requiredRoles Json
  verdicts      Json
  decision      Json?
  deadline      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  workspace     Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run           WorkflowRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  assignee      User?        @relation("ReviewAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments      Comment[]
  reviewLinks   ReviewLink[]

  @@index([workspaceId, status, createdAt])
}

model Comment {
  id             String     @id @default(cuid())
  reviewTaskId   String
  parentId       String?
  authorId       String?
  externalAuthor String?
  assetId        String?
  region         String?
  anchor         Json?
  mentions       Json?
  text           String
  resolved       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  reviewTask     ReviewTask @relation(fields: [reviewTaskId], references: [id], onDelete: Cascade)
  author         User?      @relation(fields: [authorId], references: [id])
  parent         Comment?   @relation("CommentThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies        Comment[]  @relation("CommentThread")

  @@index([reviewTaskId, createdAt])
  @@index([parentId, createdAt])
}

model OutputAsset {
  id                   String                @id @default(cuid())
  workspaceId          String
  runId                String
  assetId              String?
  name                 String
  format               String
  width                Int?
  height               Int?
  locale               String?
  status               OutputStatus          @default(DRAFT)
  qualityScores        Json?
  metadata             Json?
  approvedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run                  WorkflowRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  asset                Asset?                @relation(fields: [assetId], references: [id], onDelete: SetNull)
  publishJobs          PublishJob[]
  performanceMetrics   PerformanceMetric[]
  localizationJobs     LocalizationJob[]     @relation("LocalizationSourceOutput")
  localizationVariants LocalizationVariant[]
  consistencyChecks    ConsistencyCheck[]

  @@index([workspaceId, runId])
}

model Connection {
  id                   String                @id @default(cuid())
  workspaceId          String
  provider             String
  encryptedRef         String
  scopes               Json
  health               ConnectionHealth      @default(DISCONNECTED)
  expiresAt            DateTime?
  metadata             Json?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishJobs          PublishJob[]
  dailyPublicationJobs DailyPublicationJob[]
  driveSyncJobs        DriveSyncJob[]
  driveFiles           DriveFile[]

  @@unique([workspaceId, provider])
}

model PublishJob {
  id                 String              @id @default(cuid())
  workspaceId        String
  outputAssetId      String
  connectionId       String
  platform           String
  status             String              @default("draft")
  platformObjectId   String?
  destination        String?
  mediaChecksum      String?
  metadataHash       String?
  version            String?
  confirmation       Json
  receipt            Json?
  error              Json?
  idempotencyKey     String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  outputAsset        OutputAsset         @relation(fields: [outputAssetId], references: [id])
  connection         Connection          @relation(fields: [connectionId], references: [id])
  performanceMetrics PerformanceMetric[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status])
}

model DailyPublicationJob {
  id               String           @id @default(cuid())
  workspaceId      String
  dailyPlanId      String
  connectionId     String
  platform         String
  entryKey         String
  status           String           @default("QUEUED")
  platformObjectId String?
  destination      String?
  mediaChecksum    String?
  metadataHash     String?
  confirmation     Json
  receipt          Json?
  error            Json?
  attempts         Int              @default(0)
  idempotencyKey   String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dailyPlan        DailyContentPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  connection       Connection       @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, dailyPlanId, status])
}

model CreditAccount {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  balance     Int       @default(0)
  reserved    Int       @default(0)
  unitClass   String    @default("mixed")
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CreditReservation {
  id            String            @id @default(cuid())
  workspaceId   String
  runId         String?
  mediaJobId    String?           @unique
  amount        Int
  status        ReservationStatus @default(RESERVED)
  createdAt     DateTime          @default(now())
  settledAt     DateTime?
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run           WorkflowRun?      @relation(fields: [runId], references: [id], onDelete: Cascade)
  mediaJob      MediaJob?         @relation(fields: [mediaJobId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]

  @@index([workspaceId, status])
  @@index([runId])
}

model LedgerEntry {
  id             String             @id @default(cuid())
  workspaceId    String
  reservationId  String?
  runId          String?
  kind           LedgerKind
  amount         Int
  reason         String
  paymentRef     String?
  idempotencyKey String
  metadata       Json?
  createdAt      DateTime           @default(now())
  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reservation    CreditReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
}

model ProviderCost {
  id             String       @id @default(cuid())
  workspaceId    String
  runId          String?
  provider       String
  model          String
  modelVersion   String
  providerCallId String?
  rawUsage       Json
  costMinor      Int
  currency       String       @default("USD")
  retry          Boolean      @default(false)
  errorClass     String?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  run            WorkflowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, providerCallId])
  @@index([workspaceId, createdAt])
}

model AuditEvent {
  id             String    @id @default(cuid())
  workspaceId    String
  actorId        String?
  action         String
  targetType     String
  targetId       String
  correlationId  String
  idempotencyKey String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor          User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
}

model ConsentRecord {
  id          String    @id @default(cuid())
  workspaceId String
  subject     String
  assetId     String?
  purpose     String
  scope       Json
  expiresAt   DateTime?
  revokedAt   DateTime?
  evidenceKey String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, subject])
}

model OutboxEvent {
  id             String       @id @default(cuid())
  workspaceId    String
  brandId        String?
  runId          String?
  eventType      String
  schemaVersion  Int          @default(1)
  correlationId  String
  causationId    String?
  actorType      String?
  actorId        String?
  channel        String?
  policyContext  Json?
  idempotencyKey String
  payload        Json
  publishedAt    DateTime?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand          Brand?       @relation(fields: [brandId], references: [id], onDelete: SetNull)
  run            WorkflowRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, idempotencyKey])
  @@index([publishedAt, createdAt])
}

model IdempotencyKey {
  id             String    @id @default(cuid())
  workspaceId    String
  key            String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
  @@index([userId, revokedAt])
}

model BillingEvent {
  id          String     @id @default(cuid())
  provider    String
  eventId     String
  workspaceId String?
  type        String
  payload     Json
  status      String     @default("received")
  processedAt DateTime?
  error       String?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([provider, eventId])
  @@index([workspaceId, createdAt])
}

model Subscription {
  id                String    @id @default(cuid())
  workspaceId       String
  provider          String
  externalId        String
  plan              String
  status            String
  currency          String    @default("INR")
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
