{
  "openapi": "3.1.0",
  "info": { "title": "Creozentic API", "version": "1.0.0" },
  "servers": [{ "url": "/" }],
  "paths": {
    "/api/v1/health/ready": {
      "get": {
        "operationId": "healthReady",
        "responses": { "200": { "description": "Service is ready" } }
      }
    },
    "/api/editor/projects": {
      "post": {
        "operationId": "createEditorProject",
        "responses": { "201": { "description": "Editor project created" } }
      }
    },
    "/api/editor/projects/{projectId}": {
      "get": {
        "operationId": "getEditorProject",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Editor project" } }
      }
    },
    "/api/v1/media-jobs": {
      "post": {
        "operationId": "createMediaJob",
        "responses": { "201": { "description": "Media job queued" } }
      }
    },
    "/api/v1/publish-jobs": {
      "post": {
        "operationId": "createPublishJob",
        "responses": { "201": { "description": "Publish job queued" } }
      }
    }
  }
}
